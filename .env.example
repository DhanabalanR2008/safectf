# Copy this to .env.local and fill in your values

# Supabase PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/safectf?sslmode=require"

# next-auth secret - generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Gemini API key for AI Import
GEMINI_API_KEY="your-gemini-api-key"

# SMTP settings for email reminders
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="SafeCTF <your-email@gmail.com>"

# App URL
NEXTAUTH_URL="http://localhost:3000"
